  "keywords": ["archive", "unzip", "rar", "agent", "mcp", "security"],
  "optionalDependencies": {
    "@pak/cli-darwin-arm64": "0.1.0",
    "@pak/cli-darwin-x64": "0.1.0",
    "@pak/cli-linux-x64": "0.1.0",
    "@pak/cli-win32-x64": "0.1.0"
  }
}
